# Configure these in the alwaysdata environment. Never put real values in Git.
IP=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Public access is opt-in. Keep the provider billing cap configured separately.
AI_PUBLIC_ENABLED=false
AI_DAILY_REQUEST_LIMIT=30
AI_MONTHLY_REQUEST_LIMIT=200
# Used only when public access is off, for owner/API integrations.
AI_ACCESS_TOKEN=
